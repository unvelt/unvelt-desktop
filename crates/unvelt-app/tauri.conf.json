{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unvelt",
  "version": "0.3.0",
  "identifier": "com.unvelt.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "status",
        "title": "unvelt",
        "width": 520,
        "height": 680,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "unvelt"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQjM1RTk0RTgzNjA0QjQKUldTMEJEYm9sRjZ6SEhTbDFZRWYzNzRnaW5vQkhyZUR0OWNaaFBUN2loZ0VManJ2L2MrOWRpNEEK",
      "endpoints": [
        "https://github.com/unvelt/unvelt-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
